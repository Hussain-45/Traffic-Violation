# --- Stage 1: Node.js static build ---
FROM node:18-alpine AS builder

WORKDIR /app

# Copy dependency configs
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci

# Copy frontend source files
COPY frontend/ ./

# Disable Next.js telemetry during build
ENV NEXT_TELEMETRY_DISABLED=1

# Perform production build static export
RUN npm run build

# --- Stage 2: Nginx server runner ---
FROM nginx:alpine

# Copy custom Nginx virtualhost config
COPY deployment/docker/nginx/nginx.conf /etc/nginx/nginx.conf

# Copy build static output to Nginx default html path
COPY --from=builder /app/out /usr/share/nginx/html

EXPOSE 80

# Health check checking Nginx index
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
